source "https://rubygems.org"

ruby "3.3.5"

# --- Core framework ---
gem "rails", "~> 7.1.5"
gem "pg", "~> 1.5"              # PostgreSQL driver
gem "puma", "~> 7.2", ">= 7.2.1"  # app server (>= 7.2.1 fixes CVE-2026-47737)
gem "bootsnap", ">= 1.4.4", require: false  # faster boot via caching

# --- Auth ---
gem "bcrypt", "~> 3.1.7"       # has_secure_password (commit 2.1)
gem "jwt", "~> 2.8"            # access-token encoding (commit 2.4)
gem "pundit", "~> 2.3"        # policy-object authorization (commit 2.6)

# --- Multi-tenancy (schema-per-tenant, ADR-0002) ---
# Maintained fork of `apartment`, loaded as the `apartment` module.
gem "ros-apartment", "~> 3.2", require: "apartment"

# --- Serialization (ADR-0011). Decorators are plain POROs (ApplicationDecorator),
#     so no Draper. Blueprinter shapes JSON; first used in Milestone 4. ---
gem "blueprinter", "~> 1.1"

# --- API docs (ADR-0012): request specs generate OpenAPI; Swagger UI serves it;
#     Postman imports the OpenAPI file. ---
gem "rswag-api", "~> 2.13"
gem "rswag-ui",  "~> 2.13"

# --- Cross-origin requests from the React SPA (configured in Milestone 3) ---
# gem "rack-cors"

group :development, :test do
  gem "rspec-rails", "~> 6.1"  # test framework
  gem "dotenv-rails"           # load .env in dev/test
  gem "debug", platforms: %i[mri], require: "debug/prelude"
  gem "rswag-specs", "~> 2.13" # request-spec DSL that emits OpenAPI (ADR-0012)
  gem "factory_bot_rails", "~> 6.4" # test data factories (prefer build_stubbed; ADR-0013)
end

group :development do
  gem "rubocop-rails-omakase", require: false  # style (CI lint)
  gem "brakeman", require: false               # static security scan (CI)
  gem "bundler-audit", require: false          # gem CVE check (CI)
end
