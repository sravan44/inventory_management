# Copy this file to `.env` and adjust as needed. `.env` is gitignored (never commit secrets).
# docker-compose reads these; dotenv-rails also loads them for non-Docker runs.

DATABASE_HOST=db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
RAILS_ENV=development

# Platform admin (Motor Admin, ADR-0015). Without these the admin gate denies all.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# CORS: comma-separated SPA origins allowed to call the API (commit 3.5).
FRONTEND_ORIGINS=http://localhost:5173

# Observability (ADR-0016) — all optional / inert when blank.
SENTRY_DSN=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Log viewer file source: point at any app's log file to browse/search it.
# AUDIT_LOG_FILE=/app/log/development.log
# AUDIT_RETENTION_DAYS=90
